# Copy to .env and fill in. Use the SERVICE ROLE key: the worker runs on your machine, never in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# "wan" for realistic clips (GPU), or "procedural" for quick test clips (no GPU).
OPAW_BACKEND=procedural
